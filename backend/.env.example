# You do NOT need this file to use the program. Keys are entered in Settings > Integrations,
# and the database is a built-in file. This file is only for developers.

# Optional: use MySQL instead of the built-in database.
# DATABASE_URL=mysql+pymysql://hy_engine:your-password@127.0.0.1:3306/hy_engine?charset=utf8mb4

# Optional: create the owner account without the first-run screen.
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=choose-a-strong-password

# Optional: keep data somewhere else.
# HY_DATA_DIR=D:\HYSalesEngineData
